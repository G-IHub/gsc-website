{
  "redirects": [
    { "source": "/research-programme", "destination": "/research-lab", "permanent": true },
    { "source": "/research-to-publication-lab", "destination": "/research-lab", "permanent": true }
  ],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
